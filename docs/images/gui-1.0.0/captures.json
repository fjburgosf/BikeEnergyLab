  "examples": [
    {
      "key": "flat",
      "title": "01 · Ruta plana",
      "description": "Primer recorrido: 3 km a 6 m/s (21.6 km/h), sin pendiente y con 50 W humanos. Observe energía en Wh, consumo en Wh/km y SOC final. Es la referencia para comparar los ejemplos 02–05.",
      "operation": "simulation"
    },
    {
      "key": "hill",
      "title": "02 · Subida del 3%",
      "description": "Recorra 3 km a 5 m/s con pendiente 0.03 (3%). Compare la energía con la ruta plana y observe la contribución gravitacional en el balance. La velocidad también cambia en este ejemplo.",
      "operation": "simulation"
    },
    {
      "key": "headwind",
      "title": "03 · Viento frontal",
      "description": "La misma ruta plana con viento de −3 m/s. Compare el consumo con el ejemplo 01. Un viento negativo es frontal y aumenta la resistencia aerodinámica a esta velocidad.",
      "operation": "simulation"
    },
    {
      "key": "rider",
      "title": "04 · Mayor aporte humano",
      "description": "La misma ruta plana con 120 W en pedales. Compare con los 50 W del ejemplo 01: el motor necesita aportar menos energía. Revise las potencias humana, del motor y de batería.",
      "operation": "simulation"
    },
    {
      "key": "cold",
      "title": "05 · Ambiente frío",
      "description": "La misma ruta a 0 °C. Observe el efecto de la densidad del aire. No se ha definido una curva térmica de batería: este ejemplo no supone una pérdida de capacidad por frío.",
      "operation": "simulation"
    },
    {
      "key": "calibration",
      "title": "06 · Calibración sintética",
      "description": "Ajuste Crr y CdA con 40 rutas sintéticas sin ruido ni discrepancia. Los valores conocidos son Crr = 0.008 y CdA = 0.48 m². Revise el ajuste observado/predicho y los parámetros recuperados.",
      "operation": "calibration"
    },
    {
      "key": "uncertainty",
      "title": "07 · Viento incierto y autonomía",
      "description": "Ejecute 30 muestras con viento normal de media 0 y desviación 1 m/s. Revise dispersión de energía, bandas de SOC y autonomía. El horizonte de 80 km puede censurar la autonomía; revise ese indicador.",
      "operation": "uncertainty"
    },
    {
      "key": "hybrid",
      "title": "08 · Modelo híbrido CGPRA",
      "description": "Entrene con 60 rutas sintéticas y calibre intervalos con 25 rutas independientes; después simule la ruta plana. Revise energía CGPRA, alpha e indicador OOD. El modelo queda disponible para otras rutas y para guardar.",
      "operation": "hybrid"
    },
    {
      "key": "mission",
      "title": "09 · ¿Alcanza la batería?",
      "description": "Ruta de 26 km, SOC inicial del 38%, reserva del 15% y viento incierto. Ejecute 30 muestras y revise mission_probability: exige completar la ruta con potencia suficiente y conservar la reserva.",
      "operation": "uncertainty"
    }
  ],
  "tutorial": [
    {
      "title": "Su primera simulación",
      "description": "Empezaremos con una ruta plana sintética de 3 km. Pulse Cargar ruta plana. Reemplazará la configuración en pantalla; los archivos guardados se conservan. Los ejemplos permiten practicar sin importar datos.",
      "button": "Cargar ruta plana",
      "action": "load"
    },
    {
      "title": "Entender los parámetros",
      "description": "Revise masa, Crr y CdA en Bicicleta. Pase el cursor sobre un campo para consultar su ayuda y unidades. En Ciclista, 50 W es potencia en pedales. Puede editar valores; Simular toma la configuración actual.",
      "button": "Ver aporte del ciclista",
      "action": "rider"
    },
    {
      "title": "Comprobar la ruta",
      "description": "Visualice elevación, velocidad, pendiente y superficie. 6 m/s equivale a 21.6 km/h; 0.03 significa pendiente del 3%. Si edita los campos de ruta, pulse Crear ruta manual para aplicarlos antes de simular.",
      "button": "Visualizar ruta",
      "action": "preview"
    },
    {
      "title": "Ejecutar el cálculo",
      "description": "Pulse Simular y espere a que termine. Durante el cálculo los controles se bloquean y la barra inferior indica Calculando. Al finalizar se abrirán los resultados automáticamente.",
      "button": "Simular",
      "action": "simulate"
    },
    {
      "title": "Leer los resultados",
      "description": "Explore las pestañas de potencias, batería y balance. Wh es energía; Wh/km es consumo por distancia; SOC es la fracción de carga. En Detalles, completed_route indica recorrido completo y feasible indica potencia suficiente. Revise ambos.",
      "button": "Abrir gráficas",
      "action": "results"
    },
    {
      "title": "Practicar con incertidumbre",
      "description": "Esta acción carga y ejecuta el ejemplo 07: 30 muestras de viento incierto. Observe distribución de energía y bandas de SOC. Las probabilidades dependen de los supuestos; estas muestras sintéticas no verifican precisión real.",
      "button": "Ejecutar ejemplo 07",
      "action": "uncertainty"
    },
    {
      "title": "Guardar el trabajo",
      "description": "Exporte el último resultado y elija una carpeta. Se crea una carpeta EXP nueva con configuración, tablas, metadatos y figuras. Guardar YAML en la barra superior conserva una configuración para abrirla después.",
      "button": "Exportar resultado",
      "action": "export"
    },
    {
      "title": "Seguir explorando",
      "description": "Ya conoce el flujo principal. Compare los ejemplos 01–05, pruebe la calibración 06, el híbrido 08 y la misión 09. Puede reiniciar este tutorial cuando quiera desde la barra superior; funciona sin conexión.",
      "button": "Finalizar tutorial",
      "action": "finish"
    }
